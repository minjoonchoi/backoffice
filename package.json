{
  "name": "backoffice-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.20.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:mock": "BACKOFFICE_DATA_SOURCE=local-mock next dev --turbopack",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "ui-resources:export": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/export-ui-resources.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build",
    "storybook:test": "vitest run --project storybook",
    "e2e": "pnpm build && pnpm prepare:standalone && pnpm storybook:build && playwright test",
    "e2e:test": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm storybook:test && pnpm storybook:build && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@hookform/resolvers": "5.7.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-intl": "4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.7",
    "globals": "17.9.0",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.2",
    "storybook": "10.5.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
